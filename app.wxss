/* 全局样式 */

/* 基础颜色 */
:root {
  --primary-color: #e64340;
  --secondary-color: #f5f5f5;
  --text-color: #333;
  --text-secondary: #666;
  --border-color: #eee;
  --success-color: #07c160;
  --warning-color: #ff976a;
  --error-color: #e64340;
}

/* 全局容器 */
.container {
  min-height: 100vh;
  background-color: var(--secondary-color);
}

/* 通用按钮样式 */
.btn-primary {
  background-color: var(--primary-color);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
}

.btn-secondary {
  background-color: #fff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 8rpx;
  padding: 18rpx 38rpx;
  font-size: 32rpx;
}

.btn-disabled {
  background-color: #ccc;
  color: #999;
}

/* 通用输入框样式 */
.input {
  height: 80rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fff;
}

.input:focus {
  border-color: var(--primary-color);
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

/* 通用标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  color: var(--text-color);
  margin-bottom: 15rpx;
}

/* 通用文本样式 */
.text-primary {
  color: var(--text-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-error {
  color: var(--error-color);
}

.text-success {
  color: var(--success-color);
}

/* 通用间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

/* 通用布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 文本截断 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading::after {
  content: '';
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}