.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.region-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.region-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.switch-item {
  justify-content: space-between;
}

.btn-save {
  margin: 40rpx 30rpx;
  background-color: #e64340;
  color: #fff;
  border: none;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
}
