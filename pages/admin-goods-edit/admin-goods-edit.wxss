.edit-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.edit-header {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  text-align: center;
}

.edit-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-section {
  padding: 20rpx 30rpx;
}

.form-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #e64340;
}

.form-input {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  font-size: 28rpx;
  color: #333;
  min-height: 160rpx;
  padding: 16rpx 0;
  width: 100%;
}

/* 图片上传 */
.image-upload-area {
  margin-bottom: 16rpx;
}

.image-preview {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}

.preview-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.btn-remove-image {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.btn-choose-image {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.image-url-input {
  font-size: 24rpx;
  color: #666;
}

/* 分类选择 */
.form-picker {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
}

.picker-placeholder {
  color: #ccc;
}

.picker-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 分类选择弹窗 */
.category-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.category-picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: 40rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.picker-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.category-option {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.category-option:active {
  background: #f5f5f5;
}

.category-option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.category-option-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.category-option-check {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

/* 底部按钮 */
.form-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-save {
  background: #07c160;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
}

.btn-save text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
