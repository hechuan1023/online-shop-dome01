.edit-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ========== 顶部导航 ========== */
.edit-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: bold;
}

.edit-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.header-placeholder {
  width: 60rpx;
}

/* ========== 表单区域 ========== */
.form-scroll {
  height: calc(100vh - 100rpx);
}

.form-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.label-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.label-hint {
  font-size: 22rpx;
  color: #999;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #07c160;
}

/* ========== 图片上传 ========== */
.image-upload-wrap {
  margin-bottom: 20rpx;
}

.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.btn-remove-image {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-remove-image text {
  color: #fff;
  font-size: 24rpx;
}

.btn-choose-image {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.choose-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.choose-text {
  font-size: 24rpx;
  color: #999;
}

.image-url-input {
  font-size: 24rpx;
  color: #666;
  background: #f8f8f8;
  padding: 16rpx;
  border-radius: 8rpx;
}

/* ========== 表单项 ========== */
.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-no-border {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #e64340;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  padding: 12rpx 0;
}

/* 价格输入 */
.price-input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.price-symbol {
  font-size: 36rpx;
  color: #e64340;
  font-weight: bold;
  margin-right: 8rpx;
}

.price-input {
  flex: 1;
  border: none;
  padding: 12rpx 0;
}

/* 分类选择 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-icon-img {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
}

.picker-placeholder {
  color: #ccc;
}

.picker-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

/* 文本域 */
.form-textarea {
  font-size: 28rpx;
  color: #333;
  min-height: 160rpx;
  width: 100%;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.textarea-counter {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ========== 分类选择弹窗 ========== */
.category-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.category-picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: 40rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.picker-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.category-option {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.category-option:active {
  background: #f5f5f5;
}

.category-option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.category-option-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.category-option-check {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

/* ========== 底部按钮 ========== */
.form-bottom-placeholder {
  height: 140rpx;
}

.form-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-save {
  background: linear-gradient(135deg, #07c160, #06ad56);
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.btn-save text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
