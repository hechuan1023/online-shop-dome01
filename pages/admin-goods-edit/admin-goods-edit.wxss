.edit-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.edit-header {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  text-align: center;
}

.edit-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-section {
  padding: 20rpx 30rpx;
}

.form-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #e64340;
}

.form-input {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  font-size: 28rpx;
  color: #333;
  min-height: 160rpx;
  padding: 16rpx 0;
  width: 100%;
}

/* 图片上传 */
.image-upload-area {
  margin-bottom: 16rpx;
}

.image-preview {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}

.preview-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.btn-remove-image {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.btn-choose-image {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.image-url-input {
  font-size: 24rpx;
  color: #666;
}

/* 分类选择 */
.form-picker {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.picker-placeholder {
  color: #ccc;
}

/* 底部按钮 */
.form-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-save {
  background: #07c160;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
}

.btn-save text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
