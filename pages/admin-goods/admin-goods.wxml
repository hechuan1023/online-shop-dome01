<block wx:if="{{isAuthenticated}}">
  <view class="admin-container">
    <!-- 顶部标题栏 -->
    <view class="admin-header">
      <text class="admin-title">商品管理</text>
      <view class="header-actions">
        <view class="btn-add" bindtap="goToAdd">
          <text class="btn-add-icon">+</text>
          <text class="btn-add-text">添加</text>
        </view>
        <view class="btn-logout" bindtap="logout">
          <text>退出</text>
        </view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-box">
      <input class="search-input" placeholder="搜索商品名称..." value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
      <view class="btn-search" bindtap="onSearch">
        <text>搜索</text>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-bar" wx:if="{{total > 0}}">
      <text class="stats-text">共 {{total}} 个商品</text>
    </view>

    <!-- 商品列表 -->
    <view class="product-list" wx:if="{{products.length > 0}}">
      <view class="product-item" wx:for="{{products}}" wx:key="id">
        <image class="product-thumb" src="{{item.image}}" mode="aspectFill" bindtap="previewImage" data-src="{{item.image}}"></image>
        <view class="product-info">
          <text class="product-name">{{item.title}}</text>
          <view class="product-meta">
            <text class="product-price">¥{{item.price}}</text>
            <text class="product-stock">库存: {{item.stock}}</text>
            <text class="product-sales">销量: {{item.sales}}</text>
          </view>
        </view>
        <view class="product-actions">
          <view class="btn-edit" bindtap="goToEdit" data-id="{{item.id}}">
            <text>编辑</text>
          </view>
          <view class="btn-delete" bindtap="deleteProduct" data-id="{{item.id}}" data-title="{{item.title}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{!loading && products.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">还没有商品</text>
      <view class="btn-add-empty" bindtap="goToAdd">
        <text>立即添加</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多了 -->
    <view class="no-more" wx:if="{{!loading && products.length > 0 && page >= totalPage}}">
      <text>没有更多了</text>
    </view>
  </view>
</block>

<!-- 密码验证弹窗 -->
<view class="password-mask" wx:if="{{showPasswordDialog}}">
  <view class="password-dialog">
    <view class="password-icon">🔒</view>
    <text class="password-title">管理员验证</text>
    <text class="password-subtitle">请输入管理密码</text>
    <input class="password-input" type="digit" password="true" value="{{passwordInput}}" bindinput="onPasswordInput" bindconfirm="submitPassword" maxlength="20" auto-focus="true" />
    <text class="password-error" wx:if="{{passwordError}}">{{passwordError}}</text>
    <view class="btn-password-submit" bindtap="submitPassword">
      <text>确认</text>
    </view>
  </view>
</view>
