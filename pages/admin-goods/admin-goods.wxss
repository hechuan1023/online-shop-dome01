.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.btn-add {
  display: flex;
  align-items: center;
  background: #07c160;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.btn-add-icon {
  font-size: 28rpx;
  color: #fff;
  margin-right: 6rpx;
  font-weight: bold;
}

.btn-add-text {
  font-size: 24rpx;
  color: #fff;
}

.search-box {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
}

.btn-search {
  margin-left: 20rpx;
  background: #07c160;
  padding: 14rpx 30rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
}

.btn-search text {
  color: #fff;
  font-size: 28rpx;
}

.stats-bar {
  padding: 16rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.stats-text {
  font-size: 24rpx;
  color: #999;
}

.product-list {
  padding: 0 30rpx;
}

.product-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.product-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-price {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
}

.product-stock {
  font-size: 22rpx;
  color: #999;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.product-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.btn-edit, .btn-delete {
  padding: 10rpx 20rpx;
  border-radius: 6rpx;
  text-align: center;
}

.btn-edit {
  background: #e8f4fd;
}

.btn-edit text {
  font-size: 24rpx;
  color: #1890ff;
}

.btn-delete {
  background: #fff0f0;
}

.btn-delete text {
  font-size: 24rpx;
  color: #e64340;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-add-empty {
  background: #07c160;
  padding: 20rpx 60rpx;
  border-radius: 8rpx;
}

.btn-add-empty text {
  color: #fff;
  font-size: 30rpx;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #ccc;
  font-size: 24rpx;
}
