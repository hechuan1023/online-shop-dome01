<view class="container">
  <view class="cart-list" wx:if="{{cartItems.length > 0}}">
    <block wx:for="{{cartItems}}" wx:key="id">
      <view class="cart-item">
        <checkbox class="item-checkbox" checked="{{item.checked}}" data-id="{{item.id}}" bindtap="toggleCheck"></checkbox>
        <image class="item-image" src="{{item.localImage || item.image}}" mode="aspectFill" data-id="{{item.currentID || item.id}}" bindtap="goToDetail"></image>
        <view class="item-info">
          <text class="item-name" data-id="{{item.currentID || item.id}}" bindtap="goToDetail">{{item.title}}</text>
          <text class="item-price">¥{{item.price}}</text>
          <view class="item-actions">
            <!-- 数量控件：支持加减和手动输入 -->
            <view class="quantity-control">
              <button class="btn-quantity {{item.quantity <= 1 ? 'disabled' : ''}}" data-id="{{item.id}}" data-action="decrease" bindtap="changeQuantity">-</button>
              <input class="quantity-input" type="number" value="{{item.quantity}}" data-id="{{item.id}}" bindblur="onQuantityBlur" bindinput="onQuantityInput" />
              <button class="btn-quantity" data-id="{{item.id}}" data-action="increase" bindtap="changeQuantity">+</button>
            </view>
            <text class="btn-delete" data-id="{{item.id}}" bindtap="deleteItem">删除</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-cart" wx:if="{{!loading && cartItems.length === 0}}">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车空空如也</text>
    <button class="btn-go-shopping" bindtap="goShopping">去逛逛</button>
  </view>

  <view class="loading" wx:if="{{loading}}"></view>

  <view class="cart-footer" wx:if="{{cartItems.length > 0}}">
    <view class="select-all">
      <checkbox checked="{{allChecked}}" bindtap="toggleSelectAll"></checkbox>
      <text>全选</text>
    </view>
    <view class="total-info">
      <text class="total-label">合计：</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <button class="btn-checkout" bindtap="checkout">结算({{checkedCount}})</button>
  </view>
</view>