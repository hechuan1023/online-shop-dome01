/* ========== 全局容器 ========== */
.container {
  background-color: #f7f8fa;
  min-height: 100vh;
  /* 底部留出空间，避免被固定栏遮挡，同时适配全面屏安全区 */
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 购物车列表 ========== */
.cart-list {
  padding: 16rpx;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f0;
}

.cart-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* 复选框垂直居中 */
.item-checkbox {
  margin-right: 16rpx;
  flex-shrink: 0;
  align-self: center;
  transform: scale(1.2);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
  object-fit: cover;
  border: 1rpx solid #f0f0f0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 30rpx;
  color: #2c3e50;
  line-height: 1.4;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.item-price {
  font-size: 34rpx;
  color: #e74c3c;
  font-weight: bold;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #e74c3c, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 数量控制组件 */
.quantity-control {
  display: flex;
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  overflow: hidden;
  background: #fafafa;
}

/* 加减按钮 */
.btn-quantity {
  width: 56rpx;
  height: 56rpx;
  max-width: 56rpx !important;
  line-height: 56rpx;
  text-align: center;
  background: linear-gradient(135deg, #f8f8f8, #e9e9e9);
  font-size: 32rpx;
  padding: 0;
  border: none;
  border-radius: 0;
  font-weight: bold;
  color: #2c3e50;
  box-sizing: border-box;
}

.btn-quantity:active {
  background: linear-gradient(135deg, #e9e9e9, #d0d0d0);
}

.btn-quantity.disabled {
  color: #ccc;
  background: #f5f5f5;
}

/* 手动输入框 */
.quantity-input {
  width: 100rpx;
  height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fff;
  border: none;
  margin: 0;
  padding: 0 12rpx;
  border-left: 1rpx solid #ddd;
  border-right: 1rpx solid #ddd;
  color: #2c3e50;
  font-weight: 500;
  box-sizing: border-box;
  line-height: 56rpx;
}

/* 删除按钮 */
.btn-delete {
  font-size: 26rpx;
  color: #e74c3c;
  padding: 10rpx 16rpx;
  border-radius: 6rpx;
  background: rgba(231, 76, 60, 0.1);
  transition: all 0.3s ease;
}

.btn-delete:active {
  background: rgba(231, 76, 60, 0.2);
  transform: scale(0.95);
}

/* ========== 空购物车 ========== */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-go-shopping {
  background: linear-gradient(135deg, #e74c3c, #ff6b6b);
  color: #fff;
  border: none;
  padding: 20rpx 64rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
  transition: all 0.3s ease;
}

.btn-go-shopping:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(231, 76, 60, 0.3);
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="%23e74c3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 22v-4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M22 12h-4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>') no-repeat center top;
  background-size: 48rpx;
  padding-top: 60rpx;
  background-position: center 20rpx;
}

/* ========== 底部结算栏 ========== */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  z-index: 100;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.select-all {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.select-all text {
  font-size: 26rpx;
  margin-left: 8rpx;
  color: #666;
}

.total-info {
  flex: 1;
  text-align: right;
  margin-right: 16rpx;
  min-width: 0;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #e74c3c;
  font-weight: bold;
}

.btn-checkout {
  background: linear-gradient(135deg, #e74c3c, #ff6b6b);
  color: #fff;
  border: none;
  padding: 18rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.btn-checkout:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(231, 76, 60, 0.3);
}

/* ========== 小屏适配 ========== */
@media (max-width: 360px) {
  .cart-item {
    padding: 16rpx;
  }
  .item-image {
    width: 120rpx;
    height: 120rpx;
  }
  .item-name {
    font-size: 26rpx;
  }
  .item-price {
    font-size: 30rpx;
  }
  .btn-quantity {
    width: 44rpx;
    height: 44rpx;
    line-height: 44rpx;
    font-size: 28rpx;
  }
  .quantity-input {
    width: 66rpx;
    height: 44rpx;
    line-height: 44rpx;
    font-size: 24rpx;
    padding: 0 8rpx;
  }
  .btn-delete {
    font-size: 24rpx;
    padding: 8rpx 12rpx;
  }
  .total-price {
    font-size: 32rpx;
  }
  .btn-checkout {
    padding: 14rpx 32rpx;
    font-size: 26rpx;
  }
}