.container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ========== 购物车列表 ========== */
.cart-list {
  padding: 16rpx;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-checkbox {
  margin-right: 12rpx;
  margin-top: 60rpx;
  flex-shrink: 0;
}

.item-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.item-price {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-control {
  display: flex;
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
  overflow: hidden;
}

.btn-quantity {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #f8f8f8;
  font-size: 28rpx;
  padding: 0;
  border: none;
  border-radius: 0;
}

.btn-quantity.disabled {
  color: #ccc;
}

.quantity {
  padding: 0 20rpx;
  font-size: 26rpx;
  min-width: 50rpx;
  text-align: center;
  border-left: 1rpx solid #ddd;
  border-right: 1rpx solid #ddd;
}

/* 删除按钮 — 简洁文字链接 */
.btn-delete {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 12rpx;
}

.btn-delete:active {
  color: #e64340;
}

/* ========== 空购物车 ========== */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-go-shopping {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  color: #fff;
  border: none;
  padding: 18rpx 56rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* ========== 底部结算栏 ========== */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.select-all {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.select-all text {
  font-size: 24rpx;
  margin-left: 6rpx;
  color: #666;
}

.total-info {
  flex: 1;
  text-align: right;
  margin-right: 16rpx;
}

.total-label {
  font-size: 24rpx;
  color: #666;
}

.total-price {
  font-size: 34rpx;
  color: #e64340;
  font-weight: bold;
}

.btn-checkout {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  color: #fff;
  border: none;
  padding: 18rpx 40rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}
