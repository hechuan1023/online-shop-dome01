.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f0f2f5;
}

/* 聊天区域 */
.chat-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.chat-list {
  padding-bottom: 20rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.msg-left { flex-direction: row; }
.msg-right { flex-direction: row-reverse; }

/* 头像 */
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(230, 67, 64, 0.2);
}

.msg-avatar-user {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  box-shadow: 0 2rpx 8rpx rgba(79, 172, 254, 0.2);
}

.avatar-icon { font-size: 36rpx; }

/* 消息内容 */
.msg-content-wrap {
  max-width: 70%;
  margin: 0 16rpx;
}

.msg-name {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 6rpx;
  display: block;
}

.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  word-break: break-all;
}

.msg-bubble-bot {
  background: #fff;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.msg-bubble-user {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  border-top-right-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(230, 67, 64, 0.2);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #1a1a1a;
}

.msg-bubble-user .msg-text { color: #fff; }

/* 时间戳 */
.msg-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
  display: block;
}

.msg-time-right { text-align: right; }

/* 正在输入动画 */
.typing-bubble { padding: 24rpx 32rpx; }

.typing-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
}

.dot1 { animation: dotBounce 1.2s infinite 0s; }
.dot2 { animation: dotBounce 1.2s infinite 0.2s; }
.dot3 { animation: dotBounce 1.2s infinite 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* 快捷问题 */
.quick-questions {
  padding: 20rpx 24rpx 16rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.quick-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-tag {
  font-size: 24rpx;
  color: #e64340;
  background: #fff5f5;
  border: 1rpx solid #ffd6d6;
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
  transition: all 0.1s;
}

.quick-tag:active {
  background: #ffe0e0;
  transform: scale(0.96);
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.input-placeholder { color: #bbb; }

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.send-btn-active {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  box-shadow: 0 2rpx 12rpx rgba(230, 67, 64, 0.3);
}

.send-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}
