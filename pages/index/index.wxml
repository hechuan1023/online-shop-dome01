<view class="container">
  <view class="header">
    <text class="title">购物小程序</text>
    <text class="subtitle">发现好物，享受购物乐趣</text>
  </view>

  <view class="nav-section">
    <view class="nav-item" bindtap="goToProducts">
      <text class="nav-icon">🛍️</text>
      <text class="nav-text">商品列表</text>
    </view>
    <view class="nav-item" bindtap="goToCart">
      <text class="nav-icon">🛒</text>
      <text class="nav-text">购物车</text>
    </view>
    <view class="nav-item" bindtap="goToProfile">
      <text class="nav-icon">👤</text>
      <text class="nav-text">个人中心</text>
    </view>
  </view>

  <view class="feature-section">
    <view class="section-title">热门推荐</view>
    <view class="product-grid">
      <block wx:for="{{hotProducts}}" wx:key="id">
        <view class="product-card" bindtap="goToProductDetail" data-id="{{item.id}}">
          <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}</text>
        </view>
      </block>
    </view>
  </view>
</view>