<view class="container">
  <view class="search-bar" bindtap="goToSearch">
    <text class="search-placeholder">搜索商品...</text>
  </view>

  <swiper class="banner-swiper" indicator-dots autoplay circular wx:if="{{banners.length > 0}}">
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <image class="banner-image" src="{{item.localImage || item.image}}" mode="aspectFill"></image>
      </swiper-item>
    </block>
  </swiper>

  <view class="category-nav">
    <block wx:for="{{categories}}" wx:key="id">
      <view class="category-item" bindtap="goToCategory" data-tag="{{item.tag}}">
        <image class="category-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="category-name">{{item.name}}</text>
      </view>
    </block>
  </view>

  <view class="hot-keywords" wx:if="{{hotKeywords.length > 0}}">
    <scroll-view scroll-x class="keyword-scroll">
      <block wx:for="{{hotKeywords}}" wx:key="id">
        <text class="keyword-tag" bindtap="goToSearch">{{item.keyword}}</text>
      </block>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-title">热门推荐</view>
    <view class="product-grid">
      <block wx:for="{{products}}" wx:key="id">
        <view class="product-card" bindtap="goToProductDetail" data-id="{{item.id}}">
          <image class="product-image" src="{{item.localImage || item.image}}" mode="aspectFill"></image>
          <text class="product-name">{{item.title}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{item.price}}</text>
            <view class="btn-add-cart" catchtap="addToCart" data-item="{{item}}">+</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}"></view>
  <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">没有更多了</view>
</view>
