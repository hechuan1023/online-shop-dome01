.header {
  text-align: center;
  padding: 60rpx 30rpx;
  background-color: #fff;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #e64340;
  margin-bottom: 20rpx;
  display: block;
}

.subtitle {
  font-size: 32rpx;
  color: #666;
}

.nav-section {
  display: flex;
  background-color: #fff;
  margin: 20rpx 0;
  padding: 30rpx 0;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.nav-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.nav-text {
  font-size: 28rpx;
  color: #333;
}

.feature-section {
  background-color: #fff;
  margin: 20rpx 0;
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.product-image {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.product-price {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
}