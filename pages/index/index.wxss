.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-bar {
  padding: 20rpx;
  background-color: #fff;
}

.search-placeholder {
  display: block;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #999;
}

.banner-swiper {
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 300rpx;
}

.category-nav {
  display: flex;
  background-color: #fff;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

.hot-keywords {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.keyword-scroll {
  white-space: nowrap;
}

.keyword-tag {
  display: inline-block;
  background-color: #f5f5f5;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.section {
  background-color: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-card {
  width: calc(50% - 8rpx);
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 0;
}

.product-image {
  width: 100%;
  height: 340rpx;
  display: block;
}

.product-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  padding: 16rpx 16rpx 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.product-price {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
}

.btn-add-cart {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background-color: #e64340;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 加购物车底部提示条 */
.cart-toast {
  position: fixed;
  left: 50%;
  bottom: 120rpx;
  transform: translateX(-50%) translateY(20rpx);
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  opacity: 0;
  transition: all 0.3s ease;
  z-index: 999;
  pointer-events: none;
}

.cart-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.cart-toast-icon {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
}

.cart-toast-text {
  font-size: 26rpx;
}
