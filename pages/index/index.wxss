/* ========== 全局容器 ========== */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 搜索栏 ========== */
.search-bar {
  padding: 20rpx;
  background-color: #fff;
}

.search-placeholder {
  display: block;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #999;
}

/* ========== 轮播图 ========== */
.banner-swiper {
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 300rpx;
  background-color: #f0f0f0;
}

/* ========== 分类导航 ========== */
.category-nav {
  display: flex;
  background-color: #fff;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0; /* 防止文字溢出 */
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
  background-color: #f5f5f5; /* 占位背景 */
}

.category-name {
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* ========== 热门关键词 ========== */
.hot-keywords {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.keyword-scroll {
  white-space: nowrap;
}

.keyword-tag {
  display: inline-block;
  background-color: #f5f5f5;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

/* ========== 商品推荐区域 ========== */
.section {
  background-color: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

/* ========== 商品网格 - 双列布局（已修复华为机型单列问题） ========== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx; /* 负边距抵消卡片多余边距 */
}

.product-card {
  flex: 0 0 calc(50% - 16rpx); /* 固定宽度50%减间隙总和 */
  margin: 0 8rpx 16rpx 8rpx;   /* 左右间隙 + 下边距 */
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.product-image {
  width: 100%;
  height: 340rpx;
  display: block;
  background-color: #f5f5f5;
}

.product-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  padding: 16rpx 16rpx 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.product-price {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
}

.btn-add-cart {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background-color: #e64340;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  transition: transform 0.1s;
}

.btn-add-cart:active {
  transform: scale(0.92);
}

/* ========== 返回顶部按钮 ========== */
.back-to-top {
  position: fixed;
  right: 30rpx;
  bottom: 240rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
  z-index: 998;
  pointer-events: none;
}

.back-to-top.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.back-to-top-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.back-to-top:active {
  background-color: rgba(0, 0, 0, 0.8);
  transform: scale(0.95);
}

/* ========== 加载和结束提示 ========== */
.loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="%23e64340" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 22v-4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M22 12h-4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>') no-repeat center top;
  background-size: 48rpx;
  padding-top: 60rpx;
  background-position: center 20rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* ========== 加购物车底部提示条 ========== */
.cart-toast {
  position: fixed;
  left: 50%;
  bottom: 120rpx;
  transform: translateX(-50%) translateY(20rpx);
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  opacity: 0;
  transition: all 0.3s ease;
  z-index: 999;
  pointer-events: none;
}

.cart-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.cart-toast-icon {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
}

.cart-toast-text {
  font-size: 26rpx;
}

/* ========== 小屏幕适配 ========== */
@media (max-width: 360px) {
  .product-image {
    height: 280rpx;
  }
  .product-name {
    font-size: 24rpx;
  }
  .product-price {
    font-size: 28rpx;
  }
  .btn-add-cart {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    font-size: 28rpx;
  }
}