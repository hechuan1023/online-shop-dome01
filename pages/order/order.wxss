/* 全局容器优化 */
.container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

/* 标签栏优化：更精致、有按压效果 */
.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #646566;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item:active {
  background: #f5f5f5;
}

.tab-item.active {
  color: #ff4d4f;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 70rpx;
  height: 6rpx;
  background-color: #ff4d4f;
  border-radius: 3rpx;
}

/* 订单卡片：阴影+圆角+高级感 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
}

.order-card:active {
  transform: scale(0.98);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 26rpx;
  color: #555;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.status-0 { color: #FF7D00; }
.status-1 { color: #1677FF; }
.status-2 { color: #00B42A; }
.status-3 { color: #86909C; }
.status-4 { color: #86909C; }

/* 商品区域优化 */
.order-goods {
  display: flex;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f7f7f7;
  align-items: center;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  object-fit: cover;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.goods-quantity {
  font-size: 26rpx;
  color: #999;
}

/* 底部合计与按钮 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
}

.order-total {
  font-size: 26rpx;
  color: #666;
}

.order-total .price {
  color: #ff4d4f;
  font-weight: 500;
  font-size: 30rpx;
}

.order-actions {
  display: flex;
  gap: 12rpx;
}

.btn-action {
  font-size: 22rpx;
  padding: 0 12rpx;
  min-width: 60rpx;
  width: 48rpx;
  max-width: 128rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
  margin-left: 8rpx;
  background-color: #f7f8fa;
  color: #555;
  border: none;
  box-sizing: border-box; 
  white-space: nowrap;
  overflow: hidden;
  text-align: center;
}

.btn-action:active {
  opacity: 0.8;
}

.btn-action.primary {
  background-color: #ff4d4f;
  color: #fff;
}

.btn-action.btn-delete {
  background-color: #fff;
  color: #86909C;
  border: 1rpx solid #e5e6eb;
}

/* 空状态美化 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 220rpx;
  color: #999;
}

.empty-icon {
  font-size: 110rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载动画优化 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}