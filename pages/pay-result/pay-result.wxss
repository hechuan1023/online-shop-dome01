.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.result-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.result-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.btn-pay {
  background-color: #e64340;
  color: #fff;
  border: none;
  padding: 0 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
}

.order-info {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.action-buttons {
  padding: 40rpx 30rpx;
}

.btn-order, .btn-orders, .btn-home {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.btn-order {
  background-color: #e64340;
  color: #fff;
  border: none;
}

.btn-orders {
  background-color: #fff;
  color: #e64340;
  border: 2rpx solid #e64340;
}

.btn-home {
  background-color: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}
