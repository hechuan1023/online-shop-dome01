/* 整体容器 */
.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
  box-sizing: border-box;
}

/* 结果状态卡片 */
.result-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 图标 */
.result-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  display: block;
}

/* 标题 */
.result-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

/* 描述 */
.result-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 30rpx;
}

/* 立即支付按钮 红色 */
.btn-pay {
  background-color: #e54d42;
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border: none;
  margin-top: 10rpx;
}

.btn-pay::after {
  border: none;
}

/* 订单信息卡片 */
.order-info {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.info-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #666;
}

.info-value {
  color: #333;
  max-width: 60%;
  text-align: right;
}

/* 底部按钮组 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-buttons button {
  flex: 1;
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  border: 1rpx solid #e5e6eb;
  background: #fff;
  color: #333;
}

/* 返回首页 红色主按钮 */
.action-buttons .btn-home {
  background-color: #e54d42;
  color: #fff;
  border-color: #e54d42;
}

.action-buttons button::after {
  border: none;
}