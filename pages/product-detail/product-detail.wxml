<view class="container" wx:if="{{product}}">
  <view class="product-header">
    <image class="product-main-image" src="{{product.localImage || product.image}}" mode="aspectFill" bindtap="previewImage"></image>
    <view class="product-basic-info">
      <text class="product-title">{{product.title}}</text>
      <text class="product-price">¥{{product.price}}</text>
      <view class="product-meta">
        <text class="meta-item">库存: {{product.stock || '充足'}}</text>
        <text class="meta-item">销量: {{product.sales || 0}}</text>
      </view>
      <view class="product-actions">
        <button class="btn-add-cart" bindtap="addToCart">加入购物车</button>
        <button class="btn-buy" bindtap="buyNow">立即购买</button>
      </view>
    </view>
  </view>

  <view class="product-details">
    <view class="section-title">商品详情</view>
    <text class="product-description">{{product.description}}</text>
  </view>

  <view class="bottom-bar">
    <view class="bottom-icon" bindtap="goToCart">
      <text class="icon-text">🛒</text>
      <text class="icon-label">购物车</text>
    </view>
    <button class="bottom-btn-add" bindtap="addToCart">加入购物车</button>
    <button class="bottom-btn-buy" bindtap="buyNow">立即购买</button>
  </view>
</view>

<view class="loading" wx:if="{{loading}}"></view>

<view class="empty-tip" wx:if="{{!loading && !product}}">
  <text>商品不存在</text>
</view>
