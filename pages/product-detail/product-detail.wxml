<view class="container">
  <view class="product-header">
    <image class="product-main-image" src="{{product.image}}" mode="aspectFill"></image>
    <view class="product-basic-info">
      <text class="product-title">{{product.name}}</text>
      <text class="product-price">¥{{product.price}}</text>
      <view class="product-actions">
        <button class="btn-add-cart" bindtap="addToCart">加入购物车</button>
        <button class="btn-buy" bindtap="buyNow">立即购买</button>
      </view>
    </view>
  </view>

  <view class="product-details">
    <view class="section-title">商品详情</view>
    <text class="product-description">{{product.description}}</text>
  </view>

  <view class="specifications" wx:if="{{product.specs}}">
    <view class="section-title">规格参数</view>
    <view class="specs-list">
      <block wx:for="{{product.specs}}" wx:key="key">
        <view class="spec-item">
          <text class="spec-key">{{item.key}}：</text>
          <text class="spec-value">{{item.value}}</text>
        </view>
      </block>
    </view>
  </view>
</view>