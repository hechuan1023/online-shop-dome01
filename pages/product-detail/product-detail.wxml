<view class="container" wx:if="{{product}}">
  <!-- 商品图片轮播 -->
  <swiper class="product-swiper" indicator-dots autoplay circular>
    <block wx:for="{{product.images}}" wx:key="id">
      <swiper-item>
        <image class="swiper-image" src="{{item.localImage || item.image}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.image}}"></image>
      </swiper-item>
    </block>
  </swiper>

  <!-- 价格信息区 -->
  <view class="price-section">
    <view class="price-row">
      <text class="product-price">¥{{product.price}}</text>
      <view class="sales-info">
        <text class="sales-text">已售 {{product.sales || 0}} 件</text>
      </view>
    </view>
    <view class="price-tags">
      <text class="tag">包邮</text>
      <text class="tag">7天无理由</text>
    </view>
  </view>

  <!-- 商品标题 -->
  <view class="title-section">
    <text class="product-title">{{product.title}}</text>
    <view class="product-meta">
      <text class="meta-item">库存: {{product.stock || '充足'}}</text>
    </view>
  </view>

  <!-- 用户评价 -->
  <view class="reviews-section">
    <view class="section-header">
      <text class="section-title">用户评价 ({{reviews.length}})</text>
    </view>
    <block wx:if="{{reviews.length > 0}}">
      <block wx:for="{{reviews}}" wx:key="id">
        <view class="review-item">
          <view class="review-header">
            <image class="review-avatar" src="{{item.user_avatar}}" mode="aspectFill"></image>
            <view class="review-user">
              <text class="review-name">{{item.user_name}}</text>
              <view class="review-stars">
                <text class="star {{item.rating >= i ? 'filled' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="i" wx:key="*this">★</text>
              </view>
            </view>
            <text class="review-time">{{item.create_time}}</text>
          </view>
          <text class="review-content">{{item.content}}</text>
        </view>
      </block>
    </block>
    <view class="reviews-empty" wx:if="{{reviews.length === 0}}">
      <text>暂无评价，快来抢沙发吧~</text>
    </view>
  </view>

  <!-- 商品描述 -->
  <view class="desc-section" wx:if="{{product.description}}">
    <view class="section-title">商品详情</view>
    <text class="desc-text">{{product.description}}</text>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>

<!-- 底部操作栏 —— 仿京东风格 -->
<view class="bottom-bar" wx:if="{{product}}">
  <view class="bar-icon-btn" bindtap="contactService">
    <text class="bar-icon">💬</text>
    <text class="bar-icon-label">客服</text>
  </view>
  <view class="bar-icon-btn" bindtap="goToCart">
    <text class="bar-icon">🛒</text>
    <text class="bar-icon-label">购物车</text>
    <view class="bar-badge" wx:if="{{cartCount > 0}}">
      <text class="bar-badge-text">{{cartCount}}</text>
    </view>
  </view>
  <view class="bar-icon-btn" bindtap="goToHome">
    <text class="bar-icon">🏠</text>
    <text class="bar-icon-label">首页</text>
  </view>
  <button class="bar-btn-add" bindtap="addToCart">加入购物车</button>
  <button class="bar-btn-buy" bindtap="buyNow">立即购买</button>
</view>

<view class="loading-full" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
<view class="empty-tip" wx:if="{{!loading && !product}}">
  <text>商品不存在</text>
</view>
