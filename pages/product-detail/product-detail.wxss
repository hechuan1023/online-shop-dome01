.container {
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* ========== 图片轮播 ========== */
.product-swiper {
  width: 100%;
  height: 750rpx;
  background-color: #fff;
}

.swiper-image {
  width: 100%;
  height: 750rpx;
}

/* ========== 价格区 ========== */
.price-section {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  padding: 24rpx 24rpx 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.product-price {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
}

.sales-info {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.sales-text {
  font-size: 22rpx;
  color: #fff;
}

.price-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

/* ========== 标题区 ========== */
.title-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.product-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
}

.product-meta {
  display: flex;
  gap: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

/* ========== 用户评价 ========== */
.reviews-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  border-left: 6rpx solid #e64340;
  padding-left: 16rpx;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #f5f5f5;
}

.review-user {
  flex: 1;
}

.review-name {
  font-size: 26rpx;
  color: #333;
  display: block;
}

.review-stars {
  display: flex;
  margin-top: 4rpx;
}

.star {
  font-size: 24rpx;
  color: #ddd;
}

.star.filled {
  color: #ff9500;
}

.review-time {
  font-size: 22rpx;
  color: #bbb;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.reviews-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* ========== 商品描述 ========== */
.desc-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* ========== 底部占位 ========== */
.bottom-placeholder {
  height: 120rpx;
}

/* ========== 底部操作栏 —— 仿京东 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  padding: 0 16rpx;
  z-index: 100;
}

.bar-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  position: relative;
  flex-shrink: 0;
}

.bar-icon {
  font-size: 36rpx;
  line-height: 1;
}

.bar-icon-label {
  font-size: 18rpx;
  color: #666;
  margin-top: 4rpx;
}

.bar-badge {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  background: #e64340;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.bar-badge-text {
  font-size: 16rpx;
  color: #fff;
  font-weight: bold;
}

.bar-btn-add {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ffb347, #ff8c00);
  color: #fff;
  border: none;
  border-radius: 36rpx 0 0 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 12rpx;
}

.bar-btn-buy {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  color: #fff;
  border: none;
  border-radius: 0 36rpx 36rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

/* ========== 加载 & 空状态 ========== */
.loading-full {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
