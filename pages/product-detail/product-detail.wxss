.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.product-header {
  background-color: #fff;
  padding: 30rpx;
}

.product-main-image {
  width: 100%;
  height: 500rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.product-basic-info {
  padding: 0 10rpx;
}

.product-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.product-price {
  font-size: 48rpx;
  color: #e64340;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.product-meta {
  display: flex;
  margin-bottom: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 30rpx;
}

.product-actions {
  display: flex;
  gap: 20rpx;
}

.btn-add-cart, .btn-buy {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-add-cart {
  background: linear-gradient(135deg, #ffb347, #ff8c00);
  color: #fff;
  border: none;
}

.btn-buy {
  background: linear-gradient(135deg, #ff6b6b, #e64340);
  color: #fff;
  border: none;
}

.product-details {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #e64340;
  padding-left: 20rpx;
}

.product-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  padding: 0 20rpx;
}

.bottom-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.icon-text {
  font-size: 36rpx;
}

.icon-label {
  font-size: 20rpx;
  color: #666;
}

.bottom-btn-add {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ffb347, #ff8c00);
  color: #fff;
  border: none;
  border-radius: 36rpx 0 0 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.bottom-btn-buy {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #ff6b6b, #e64340);
  color: #fff;
  border: none;
  border-radius: 0 36rpx 36rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
