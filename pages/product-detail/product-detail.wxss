/* ========== 全局容器 ========== */
.container {
  background-color: #f7f8fa;
  min-height: 100vh;
  /* 底部留出底部栏高度(100rpx) + 安全区，防止内容被遮挡 */
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ========== 图片轮播 ========== */
.product-swiper {
  width: 100%;
  height: 750rpx;
  background-color: #fff;
  position: relative;
}

.swiper-image {
  width: 100%;
  height: 750rpx;
  background-color: #f5f5f5;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ccc"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 8h-4v4h-4v-4H6V9h4V5h4v4h4v2z"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 60rpx;
}

/* ========== 价格区 ========== */
.price-section {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  padding: 24rpx 24rpx 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}

.product-price {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.2;
}

.sales-info {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.sales-text {
  font-size: 22rpx;
  color: #fff;
}

.price-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(2px);
}

/* ========== 标题区 ========== */
.title-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.product-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.product-meta {
  display: flex;
  gap: 30rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

/* ========== 用户评价 ========== */
.reviews-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  border-left: 6rpx solid #e64340;
  padding-left: 16rpx;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.review-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #f5f5f5;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ccc"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>');
  background-repeat: no-repeat;
  background-position: center;
  background-size: 32rpx;
  flex-shrink: 0;
}

.review-user {
  flex: 1;
  min-width: 0; /* 防止溢出 */
}

.review-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.review-stars {
  display: flex;
  margin-top: 4rpx;
}

.star {
  font-size: 24rpx;
  color: #ddd;
}

.star.filled {
  color: #ff9500;
}

.review-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-word;
}

.reviews-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* ========== 商品描述 ========== */
.desc-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  word-break: break-word;
}

/* 底部占位（已由 container 的 padding-bottom 承担，但保留以兼容额外滚动） */
.bottom-placeholder {
  height: 0;
}

/* ========== 底部操作栏 —— 仿京东（适配安全区） ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  padding: 0 16rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  height: calc(100rpx + constant(safe-area-inset-bottom));
  height: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bar-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  position: relative;
  flex-shrink: 0;
}

.bar-icon {
  font-size: 40rpx;
  line-height: 1;
}

.bar-icon-label {
  font-size: 18rpx;
  color: #666;
  margin-top: 4rpx;
}

.bar-badge {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  background: #e64340;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.bar-badge-text {
  font-size: 16rpx;
  color: #fff;
  font-weight: bold;
}

.bar-favorite-btn .bar-icon {
  transition: transform 0.2s;
}

.bar-favorite-btn:active .bar-icon {
  transform: scale(1.2);
}

.bar-icon-favorite {
  animation: favorite-pop 0.3s ease;
}

.bar-label-favorite {
  color: #e64340 !important;
}

@keyframes favorite-pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.bar-btn-add,
.bar-btn-buy {
  flex: 1;
  height: 72rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  box-sizing: border-box;
  line-height: 1; /* 辅助 flex 垂直居中 */
}

.bar-btn-add {
  background: linear-gradient(135deg, #ffb347, #ff8c00);
  color: #fff;
  border-radius: 36rpx 0 0 36rpx;
  margin-left: 12rpx;
}

.bar-btn-buy {
  background: linear-gradient(135deg, #e64340, #ff6b6b);
  color: #fff;
  border-radius: 0 36rpx 36rpx 0;
}

/* 去除 button 默认边框和伪类 */
.bar-btn-add::after,
.bar-btn-buy::after {
  border: none;
}

/* ========== 加载 & 空状态 ========== */
.loading-full {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
  background: #f7f8fa;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
  background: #f7f8fa;
}

/* ========== 小屏幕适配 ========== */
@media (max-width: 360px) {
  .product-swiper,
  .swiper-image {
    height: 600rpx;
  }
  .product-price {
    font-size: 48rpx;
  }
  .product-title {
    font-size: 30rpx;
  }
  .review-avatar {
    width: 48rpx;
    height: 48rpx;
    background-size: 24rpx;
  }
  .review-name {
    font-size: 24rpx;
  }
  .review-stars .star {
    font-size: 20rpx;
  }
  .review-content {
    font-size: 24rpx;
  }
  .bar-icon {
    font-size: 36rpx;
  }
  .bar-icon-label {
    font-size: 16rpx;
  }
  .bar-btn-add,
  .bar-btn-buy {
    height: 64rpx;
    font-size: 26rpx;
  }
  .bottom-bar {
    padding: 0 12rpx;
  }
}