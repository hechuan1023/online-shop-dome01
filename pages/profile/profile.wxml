<view class="container">
  <!-- 头部用户信息区域 -->
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="user-basic" bindtap="{{isLoggedIn ? '' : 'goToLogin'}}">
        <view class="avatar-wrap">
          <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view class="avatar-border"></view>
          <view class="vip-badge" wx:if="{{isLoggedIn}}">
            <text class="vip-text">VIP</text>
          </view>
        </view>
        <view class="user-meta">
          <text class="username">{{userInfo.nickName}}</text>
          <view class="user-tags">
            <text class="tag tag-vip" wx:if="{{isLoggedIn}}">黄金会员</text>
            <text class="tag tag-login" wx:else>点击登录享更多权益</text>
          </view>
        </view>
      </view>
      <view class="header-right">
        <view class="qrcode-icon" bindtap="showQRCode">
          <text class="iconfont">码</text>
        </view>
        <button class="btn-logout" wx:if="{{isLoggedIn}}" catchtap="logout">退出</button>
      </view>
    </view>
  </view>

  <!-- 资产统计条 -->
  <view class="stats-card">
    <view class="stats-item" bindtap="goToOrders">
      <text class="stats-num">{{stats.orderCount}}</text>
      <text class="stats-label">全部订单</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="goToFavorites">
      <text class="stats-num">{{stats.favoriteCount}}</text>
      <text class="stats-label">收藏</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="goToCoupons">
      <text class="stats-num">{{stats.couponCount}}</text>
      <text class="stats-label">优惠券</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="goToPoints">
      <text class="stats-num">{{stats.points}}</text>
      <text class="stats-label">积分</text>
    </view>
  </view>

  <!-- 订单状态快捷入口 -->
  <view class="order-card" bindtap="goToOrders">
    <view class="card-header">
      <text class="card-title">我的订单</text>
      <view class="card-more" catchtap="goToOrders">
        <text class="more-text">全部订单</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="order-status-list">
      <view class="status-item" catchtap="switchTab" data-status="0">
        <view class="status-icon-wrap">
          <text class="status-icon">💳</text>
          <view class="badge" wx:if="{{stats.unpaidCount > 0}}">
            <text class="badge-text">{{stats.unpaidCount}}</text>
          </view>
        </view>
        <text class="status-label">待付款</text>
      </view>
      <view class="status-item" catchtap="switchTab" data-status="1">
        <view class="status-icon-wrap">
          <text class="status-icon">📦</text>
          <view class="badge" wx:if="{{stats.unshipCount > 0}}">
            <text class="badge-text">{{stats.unshipCount}}</text>
          </view>
        </view>
        <text class="status-label">待发货</text>
      </view>
      <view class="status-item" catchtap="switchTab" data-status="2">
        <view class="status-icon-wrap">
          <text class="status-icon">🚚</text>
          <view class="badge" wx:if="{{stats.shippedCount > 0}}">
            <text class="badge-text">{{stats.shippedCount}}</text>
          </view>
        </view>
        <text class="status-label">待收货</text>
      </view>
      <view class="status-item" catchtap="switchTab" data-status="3">
        <view class="status-icon-wrap">
          <text class="status-icon">⭐</text>
        </view>
        <text class="status-label">待评价</text>
      </view>
      <view class="status-item" catchtap="goToRefund">
        <view class="status-icon-wrap">
          <text class="status-icon">🔄</text>
        </view>
        <text class="status-label">退换货</text>
      </view>
    </view>
  </view>

  <!-- 服务中心 -->
  <view class="menu-card">
    <view class="card-header">
      <text class="card-title">我的服务</text>
    </view>
    <view class="menu-grid">
      <view class="menu-item" bindtap="goToAddress">
        <view class="menu-icon-wrap icon-address">
          <text class="menu-icon">📍</text>
        </view>
        <text class="menu-text">收货地址</text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon-wrap icon-favorite">
          <text class="menu-icon">❤</text>
        </view>
        <text class="menu-text">我的收藏</text>
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="menu-icon-wrap icon-service">
          <text class="menu-icon">💬</text>
        </view>
        <text class="menu-text">联系客服</text>
      </view>
      <view class="menu-item" bindtap="goToCoupons">
        <view class="menu-icon-wrap icon-coupon">
          <text class="menu-icon">🎫</text>
        </view>
        <text class="menu-text">优惠券</text>
      </view>
      <view class="menu-item" bindtap="goToPoints">
        <view class="menu-icon-wrap icon-points">
          <text class="menu-icon">💰</text>
        </view>
        <text class="menu-text">积分商城</text>
      </view>
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-icon-wrap icon-settings">
          <text class="menu-icon">⚙</text>
        </view>
        <text class="menu-text">设置</text>
      </view>
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-icon-wrap icon-help">
          <text class="menu-icon">❓</text>
        </view>
        <text class="menu-text">帮助中心</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-icon-wrap icon-about">
          <text class="menu-icon">ℹ</text>
        </view>
        <text class="menu-text">关于我们</text>
      </view>
    </view>
  </view>
</view>
