/* ========== 全局容器 ========== */
.container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 头部用户信息 ========== */
.user-header {
  position: relative;
  padding-bottom: 50rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 340rpx;
  background: linear-gradient(160deg, #e64340 0%, #ff6b6b 50%, #ff8f6b 100%);
}

.header-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #f7f8fa;
  border-radius: 50% 50% 0 0;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 80rpx 40rpx 0;
}

.user-basic {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0; /* 防止文字溢出 */
}

/* 头像区域 - 优化稳定布局 */
.avatar-wrap {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  z-index: 2;
  background-color: #f5f5f5; /* 占位背景 */
}

.avatar-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
}

.vip-badge {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.4);
}

.vip-text {
  font-size: 18rpx;
  font-weight: bold;
  color: #8B4513;
  line-height: 1;
}

.user-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0; /* 防止文字溢出 */
}

.username {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  display: inline-block;
  max-width: 200rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag-vip {
  background: linear-gradient(135deg, #fff8e1, #ffe0b2);
  color: #b7791f;
  font-weight: 500;
}

.tag-login {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.qrcode-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 24rpx;
  color: #fff;
}

.btn-logout {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  width: 125rpx;
  max-width: 125rpx;
}
.btn-logout::after {
  border: none;
}

/* ========== 资产统计条 ========== */
.stats-card {
  position: relative;
  z-index: 2;
  margin: -20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, #eee, transparent);
  align-self: center;
  flex-shrink: 0;
}

/* ========== 订单状态卡片 ========== */
.order-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.more-text {
  font-size: 26rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

.order-status-list {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap; /* 小屏自动换行 */
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.status-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.status-icon {
  font-size: 44rpx;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #e64340;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 2rpx solid #fff;
  box-sizing: border-box;
}

.badge-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.status-label {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* ========== 服务中心 ========== */
.menu-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx 0;
}

.menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  box-sizing: border-box;
  flex-shrink: 0;
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: transform 0.1s;
}

.menu-icon-wrap:active {
  transform: scale(0.92);
}

.menu-icon {
  font-size: 36rpx;
}

.menu-text {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 0 8rpx;
  box-sizing: border-box;
}

/* 每个图标的背景色 */
.icon-address { background: linear-gradient(135deg, #e3f2fd, #bbdefb); }
.icon-favorite { background: linear-gradient(135deg, #fce4ec, #f8bbd0); }
.icon-coupon { background: linear-gradient(135deg, #fff3e0, #ffe0b2); }
.icon-points { background: linear-gradient(135deg, #f3e5f5, #e1bee7); }
.icon-settings { background: linear-gradient(135deg, #eceff1, #cfd8dc); }
.icon-help { background: linear-gradient(135deg, #e8f5e9, #c8e6c9); }
.icon-about { background: linear-gradient(135deg, #e0f7fa, #b2ebf2); }
.icon-service { background: linear-gradient(135deg, #fff8e1, #ffecb3); }
.icon-admin { background: linear-gradient(135deg, #ff6b6b, #ee5a24); }

/* ========== 小屏适配 ========== */
@media (max-width: 450px) {
  .menu-item {
    width: 33.33%; /* 改为3列，避免图标过挤 */
  }
  .stats-num {
    font-size: 36rpx;
  }
  .status-icon-wrap {
    width: 64rpx;
    height: 64rpx;
  }
  .status-icon {
    font-size: 40rpx;
  }
}

@media (max-width: 360px) {
  .menu-item {
    width: 50%; /* 极小屏改为2列 */
  }
  .stats-num {
    font-size: 32rpx;
  }
  .username {
    font-size: 34rpx;
  }
}